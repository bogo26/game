# Normalize line endings for all text files (Godot uses LF)
* text=auto eol=lf
# ...except Windows batch files, which cmd misreads with LF endings
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.aseprite binary
*.ase binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
